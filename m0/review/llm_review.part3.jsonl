6635a6ffbf05b52727d50", "detector_index": 26}, {"candidate": "0x5d16b8ba2a9a4eca6126635a6ffbf05b52727d50", "detector_index": 27}, {"candidate": "0x5d16b8ba2a9a4eca6126635a6ffbf05b52727d50", "detector_index": 28}], "victim_has_source": true, "confidence": "high", "notes": "withdraw(_amount) pays getPendingRewards(), which is the full reward on every matured deposit, regardless of how much is withdrawn and without ever resetting it; the PoC withdraws 1 wei 800 times after the 14-day vest and receives the full reward each call. None of the sorraStaking findings describe this: the two reentrancy-benign hits are on nonReentrant functions calling a trusted extension and the timestamp warnings are ordinary vesting comparisons, so they are false positives, and no detector flags the reward-accounting flaw."}
