{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hindsight.invalid/schemas/community-incident.v1.json",
  "title": "Hindsight proposed community incident lead",
  "description": "Metadata only. No source/article/post bodies, secrets, or code. All records are unresolved discovery leads, never benchmark or training examples. The offline validator additionally enforces public URL policy, secret/payload guards, bounded file size, filenames, and cross-record duplicate checks. Schema validation alone is insufficient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adjudication",
    "benchmark_promoted",
    "candidate_id",
    "chain_id",
    "coverage_gaps",
    "discovered_at",
    "evaluation_eligible",
    "family_id",
    "first_seen_at",
    "human_verified",
    "identifier_verification",
    "incident_date",
    "intake_status",
    "label_status",
    "language",
    "name",
    "primary_sources",
    "schema_version",
    "source_policy",
    "split",
    "summary",
    "training_eligible",
    "tx_hashes",
    "victim_addresses"
  ],
  "properties": {
    "adjudication": {
      "const": "unresolved"
    },
    "benchmark_promoted": {
      "const": false
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^community_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "chain_id": {
      "const": 1
    },
    "coverage_gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "discovered_at": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evaluation_eligible": {
      "const": false
    },
    "family_id": {
      "const": null
    },
    "first_seen_at": {
      "const": null
    },
    "human_verified": {
      "const": false
    },
    "identifier_verification": {
      "const": "source_reported_unverified"
    },
    "incident_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "intake_status": {
      "const": "discovery_only"
    },
    "label_status": {
      "const": "proposed"
    },
    "language": {
      "const": "Solidity"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "primary_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "published_date",
          "summary"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 2048
          },
          "published_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      }
    },
    "schema_version": {
      "const": "hindsight.community-incident.v1"
    },
    "source_policy": {
      "const": "link_and_own_summary_only"
    },
    "split": {
      "const": "unassigned"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "training_eligible": {
      "const": false
    },
    "tx_hashes": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{64}$"
      }
    },
    "victim_addresses": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    }
  }
}
